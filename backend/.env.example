# Authentication Mode (Set to true to use Google Cloud Vertex AI / ADC)
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=your-gcp-project-id-here
GOOGLE_CLOUD_LOCATION=us-central1

# Google AI Studio API Key (Used if GOOGLE_GENAI_USE_VERTEXAI=false)
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# Model Selection
GEMINI_MODEL=gemini-2.5-flash

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Shadow Testing Configuration (Chapter 10.5: Shadow-testing new models)
SHADOW_TEST_ENABLED=false
SHADOW_MODEL_ID=gemini-2.5-flash
SHADOW_SAMPLE_RATE=1.0
SHADOW_TIMEOUT_SEC=30.0
# SHADOW_LOG_PATH=eval/traffic/data/shadow_log.jsonl
